SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Use local PostGIS (docker-compose) or your hosted DB URL.
DATABASE_URL=postgres://postgres:postgres@db:5432/hitchhike

# Mapbox
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret

# Campus auth
CAMPUS_EMAIL_DOMAINS=@rockets.utoledo.edu,@utoledo.edu

# Frontend callback target after OAuth
FRONTEND_BASE_URL=http://localhost:5173

# Microsoft OAuth (Azure App Registration)
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/rides/auth/microsoft/callback/
